        "source": "https://github.com/seoultra/seo-cookies"
    },
    "require": {
        "php": ">=7.4",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "SeoUltra\\SeoCookies\\": "src/" }
    },
    "scripts": {
        "test": "php tests/php/run.php"
    }
